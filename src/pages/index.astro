---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import ExpertiseGrid from "@components/sections/ExpertiseGrid.astro";
import FormationCard from "@components/sections/FormationCard.astro";
import PillarsGrid from "@components/sections/PillarsGrid.astro";
import CTASection from "@components/sections/CTASection.astro";
import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/shared/SectionHeading.astro";
import { organizationJsonLd } from "@lib/seo";

const academyUrl = "https://academy.afriklearn-consulting.com/formations.html";

// Pôles "Santé publique" et "Data & Digital Learning" : contenu confirmé via
// academy.afriklearn-consulting.com (fetched 18/11/2026). Le pôle "Gestion de
// projet & PMO" n'a aucun équivalent confirmé sur l'Academy (qui ne compte que
// 2 pôles réels : Digital Learning & Conseil, Santé Publique) — reste en
// {{PLACEHOLDER}}, À ARBITRER avec le client : service réel distinct à détailler,
// ou carte à retirer/fusionner ?
const expertiseItems = [
  {
    title: "Santé publique & systèmes d'information",
    description:
      "Vaccinologie appliquée et surveillance épidémiologique, santé communautaire (SMNI, WASH, nutrition), évaluation des systèmes de santé et économie de la santé — pour ministères, ONG et bailleurs.",
  },
  {
    title: "Gestion de projet & PMO",
    description:
      "{{PLACEHOLDER}} Certifications PMI/PMP, mise en place de PMO, pilotage de programmes multi-pays.",
  },
  {
    title: "Data & Digital Learning",
    description:
      "Digitalisation et professionnalisation des dispositifs de formation : audit pédagogique, conception de modules e-learning (SCORM), déploiement de plateformes LMS Moodle et formation de formateurs.",
  },
];

// 3 formations représentatives parmi les 14 réellement publiées sur l'Academy
// (liste complète dans src/pages/formations.astro).
const featuredFormations = [
  {
    title: "Formation Formateurs — Niveau Basique (5 jours)",
    pole: "Digital Learning & Conseil",
    duration: "5 jours",
    format: "Hybride" as const,
  },
  {
    title: "Vaccinologie appliquée & surveillance épidémiologique",
    pole: "Santé Publique",
    duration: "5 jours",
    format: "Présentiel" as const,
  },
  {
    title: "Production Module E-Learning Standard",
    pole: "Digital Learning & Conseil",
    duration: "Sur mesure",
    format: "Distanciel" as const,
  },
];

const pillars = [
  { title: "Expertise terrain", description: "{{PLACEHOLDER}} Des formateurs issus du terrain, pas seulement de la théorie." },
  { title: "Approche panafricaine", description: "{{PLACEHOLDER}} Une compréhension fine des réalités institutionnelles africaines." },
  { title: "Certifications reconnues", description: "{{PLACEHOLDER}} PMI, OMS et partenaires académiques." },
  { title: "Accompagnement post-formation", description: "{{PLACEHOLDER}} Un suivi qui ne s'arrête pas à la remise du certificat." },
];
---

<BaseLayout
  title="Bâtir les compétences qui transforment l'Afrique"
  description="AFRIK'LEARN Consulting — cabinet de formation professionnelle et conseil stratégique en Afrique francophone. Santé publique, gestion de projet, data & digital learning."
  path="/"
  jsonLd={organizationJsonLd()}
>
  <Hero
    title="Bâtir les compétences qui transforment l'Afrique."
    subtitle="Ingénierie de formation, conseil et expertise en santé publique pour les institutions, ONG et entreprises engagées sur le continent."
    primaryCta={{ label: "Nos formations", href: "/formations" }}
    secondaryCta={{ label: "Demander un devis", href: "/contact" }}
  />

  <ExpertiseGrid heading="Nos pôles d'expertise" items={expertiseItems} />

  <section class="py-16 md:py-24">
    <Container as="div">
      <SectionHeading
        title="Formations phares"
        description="Un aperçu de notre catalogue — l'inscription se fait sur notre plateforme Academy."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {featuredFormations.map((formation) => (
          <FormationCard
            title={formation.title}
            pole={formation.pole}
            duration={formation.duration}
            format={formation.format}
            academyUrl={academyUrl}
          />
        ))}
      </div>
    </Container>
  </section>

  <PillarsGrid heading="Pourquoi AFRIK'LEARN" pillars={pillars} />

  <CTASection
    title="Discutons de votre projet"
    description="Formation sur mesure, conseil stratégique ou partenariat institutionnel — parlons-en."
    cta={{ label: "Nous contacter", href: "/contact" }}
  />
</BaseLayout>

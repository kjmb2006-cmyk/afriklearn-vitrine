---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "center" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left"]}>
  {eyebrow && (
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-al-accent-700">
      {eyebrow}
    </p>
  )}
  <h2 class="text-al-ink-900">{title}</h2>
  {description && <p class="mt-4 text-al-ink-500">{description}</p>}
</div>

---
import Container from "@components/layout/Container.astro";
import Button from "@components/shared/Button.astro";

interface Props {
  title: string;
  description?: string;
  cta: { label: string; href: string };
}

const { title, description, cta } = Astro.props;
---

<section class="bg-al-primary-900 py-16 md:py-20">
  <Container as="div" class="flex flex-col items-center gap-6 text-center">
    <h2 class="text-white">{title}</h2>
    {description && <p class="max-w-xl text-al-ink-100">{description}</p>}
    <Button href={cta.href} variant="accent" size="lg">
      {cta.label}
    </Button>
  </Container>
</section>

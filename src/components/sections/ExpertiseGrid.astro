---
import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/shared/SectionHeading.astro";
import Badge from "@components/shared/Badge.astro";

interface ExpertiseItem {
  title: string;
  description: string;
  badge?: string;
}

interface Props {
  heading: string;
  items: ExpertiseItem[];
}

const { heading, items } = Astro.props;
---

<section class="py-16 md:py-24">
  <Container as="div">
    <SectionHeading title={heading} />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {items.map((item) => (
        <div class="rounded-2xl border border-al-ink-100 p-6">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-xl text-al-ink-900">{item.title}</h3>
            {item.badge && <Badge variant="neutral">{item.badge}</Badge>}
          </div>
          <p class="mt-3 text-sm text-al-ink-500">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
